# Copy this file to .streamlit/secrets.toml and replace the placeholders.
# secrets.toml is listed in .gitignore, so the real keys are never committed.
# Environment variables with the same names take precedence over this file.

# Which model parses requests: "gemini" (default) or "anthropic".
LLM_PROVIDER = "gemini"

# Only the key for the chosen provider is needed.
GEMINI_API_KEY = "your-gemini-key-here"
ANTHROPIC_API_KEY = "your-anthropic-key-here"
